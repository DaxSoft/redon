{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "useUnknownInCatchVariables": true,
    "alwaysStrict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@redon/design-system": ["packages/design-system/src/index.ts"],
      "@redon/ui": ["packages/ui/src/index.ts"],
      "@redon/shell": ["packages/shell/src/index.ts"],
      "@redon/ipc-contracts": ["packages/ipc-contracts/src/index.ts"],
      "@redon/local-db": ["packages/local-db/src/index.ts"],
      "@redon/redis-core": ["packages/redis-core/src/index.ts"],
      "@redon/redis-connections": ["packages/redis-connections/src/index.ts"],
      "@redon/redis-explorer": ["packages/redis-explorer/src/index.ts"],
      "@redon/redis-types": ["packages/redis-types/src/index.ts"],
      "@redon/redis-metrics": ["packages/redis-metrics/src/index.ts"],
      "@redon/bullmq-visualizer": ["packages/bullmq-visualizer/src/index.ts"],
      "@redon/plugin-contracts": ["packages/plugin-contracts/src/index.ts"],
      "@redon/errors": ["packages/errors/src/index.ts"],
      "@redon/logger": ["packages/logger/src/index.ts"],
      "@redon/utils": ["packages/utils/src/index.ts"]
    }
  }
}
